  <Data path="ForwardPlusShadows.Params" type="ForwardPlusShadowParams">
    <property id="CanBeEnabled" value="true"/>
    <property id="Enabled" value="false"/>
    <property id="AsyncRenderEnabled" value="true"/>
    <property id="AllowShadowCaching" value="false"/>
    <property id="AllowCacheRoundRobinUpdate" value="false"/>
    <property id="FrustumFOVScale" value="1"/>
    <property id="FrustumDistanceScale" value="1"/>
    <property id="GenerateMips" value="false"/>
    
    <!-- Max number of shadow casting F+ lights. Upper limit is 128 -->
    <property id="MaxShadowedLights" value="4"/>
    <!-- How many lights to update each frame based on screen coverage -->
    <property id="MaxDynamicLightUpdates" value="4"/>
    <!-- How many lights to update each frame based on time since last render-->
    <property id="MaxStaticLightUpdates" value="0"/>
    
    <!-- Light selection priority based on distance to the camera. Normalised into a score using MaxShadowedLightDistance -->
    <property id="DistanceSelectionWeight" value="1.0"/>
    <property id="MaxShadowedLightDistance" value="200.0"/>
    <!-- The priority range over which we'll fade out old shadowed lights and fade in new ones -->
    <property id="LightSelectionFadeRange" value="0.125"/>
    <!-- Light Selection priority based on light screen coverage -->
    <property id="ScreenCoverageSelectionWeight" value="0.0"/>
    <!-- Small constant priority bonus applied to selected lights to avoid small movements causing lots of rapid change in selected lights -->
    <property id="SelectedLightPriorityBonus" value="0.0005"/>
    <!-- Weight used to control fading of PCSS ShadowMask lights. Weight is a distance based on difference in priority between currently selected and next highest priority light -->
    <property id="ShadowMaskPriorityFadeWeight" value="0.25"/>
    <!-- For presets marked as high priority shadow casters we add an additional priority bonus -->
    <property id="HighPriorityShadowCasterPriorityBonus" value="1.0"/>

    <!-- PCF filtering settings -->
    <property id="PCFParams" type="ForwardPlusShadowPCFParams">
        <!-- Depth bias used for PCF shadow samples -->
        <property id="Bias" value="0.00001"/>
    </property>
  </Data>

