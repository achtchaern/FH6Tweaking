    <!-- Per config base settings -->
    <Settings path="LightGlow.Data" tags="Config.LensEffects.Off OR Config.LensEffects.Low OR Config.LensEffects.Medium OR Config.LensEffects.High">
      <property id="OcclusionDistantPushOut" value="0.001" />
    </Settings>
    <Settings path="LightGlow.Data" tags="Platform.Anaconda OR Platform.Lockhart OR Config.LensEffects.Ultra OR Config.LensEffects.Extreme">
      <property id="OcclusionDistantPushOut" value="0.004" />
    </Settings>
    
    <!-- Setup correct RenderModes -->
    <Settings path="LightGlow.Data" tags="Presentation.MinimalMemorySettings">
      <property id="MaxGlows" value="1024"/>
