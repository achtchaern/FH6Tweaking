</Settings>

<!-- Foliage CSM overrides -->
<Settings path="MaterialIDProperties" tags="">   
  <!-- We apply a bias of 1m to the trees to avoid self shadowing issues due to round robin. This happens a lot during high wind -->
  <property id="CSMBiasOffset" value="1.0" tags="DeferredTag.Tree"/>
  <!-- 0.16m to grass cards -->    
  <property id="CSMBiasOffset" value="0.16" tags="DeferredID.GrassBillboard"/>
</Settings>

<!-- On Scarlett60Hz and non extreme PC shadow setting we apply a small shadow offset to Trees and Bushes -->
<Settings path="MaterialIDProperties" tags="Config.Scarlett60Hz OR Config.PlayStation60Hz OR (Platform.PC AND -Config.ShadowQuality.Extreme)">    
  <property id="CSMBiasOffset" value="1.25" tags="DeferredTag.Tree"/>
  <property id="CSMBiasOffset" value="1.6" tags="DeferredTag.Bush"/>
</Settings>

<!-- On Scarlett30Hz and extreme PC shadow mode, we apply a shadow penumbra offset to the Tree and Grass cards -->
<Settings path="MaterialIDParams" tags="Config.Scarlett30Hz OR Config.PlayStation30Hz OR (Platform.PC AND Config.ShadowQuality.Extreme)">
  <property id="PenumbraOffsetEnabled" value="1"/>
</Settings>

<!-- For character focused scenarios we want to tweak the character GTAO a bit -->
<Settings path="MaterialIDProperties" tags="DeferredTag.Character AND (Scenario.Race OR Scenario.Freeroam OR Scenario.ThreeTwoOne)">
  <property id="GTAOIntensity" value="1.0"/>
  <property id="ScreenSpaceIndirectReprojectionStrength" value="0.0"/>
</Settings>

<!-- Apply small bias to the AI/Traffic cars to get rid of self shadowing artefacrs due to using a lower shadow LOD compared to the MainScene -->
<Settings path="MaterialIDProperties" tags="DeferredID.Car AND (Config.Scarlett60Hz OR Config.PlayStation60Hz OR (Platform.PC AND -Config.ShadowQuality.Extreme))">
  <property id="PSSMBiasOffset" value="0.0075"/>
</Settings>

<!-- We don't want GTAO on the hair, as it doesn't resolve well. -->
<Settings path="MaterialIDProperties" tags="DeferredID.CharacterHair">
    <property id="GTAOIntensity" value="0.175"/>
</Settings>


<!-- Flags self-shadow in CSMs when animating -->
<Settings path="MaterialIDProperties" tags="DeferredID.Flag">
  <property id="CSMBiasOffset" value="0.2" />
</Settings>
  
<!-- Allow cinematics to force a slightly softer shadow on character skin -->
<Settings path="MaterialIDProperties" tags="DeferredID.CharacterSkin AND Cinematic.ForceCharacterSoftShadow">
  <property id="PenumbraOffset" value="0.003" />
</Settings>

