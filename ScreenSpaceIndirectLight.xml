  <!-- Game area overrides -->
  <Settings path="ScreenSpaceGI.Params" tags="(Scenario.Homespace AND -Scenario.PlayerHouse)">
    <property id="Occlusion.Base.Raycasting.Radius" value="0.35"/>
    <property id="Occlusion.Base.Raycasting.EndFalloff" value="1"/>
  </Settings>
  
  <!-- Game area overrides -->
  <Settings path="ScreenSpaceGI.Params" tags="(Scenario.PlayerHouse OR Scenario.PlayerHousePhotoMode)">
    <property id="Occlusion.Base.Raycasting.Radius" value="0.16"/>
    <property id="Occlusion.Base.Raycasting.Intensity" value="1.1"/>
  </Settings>
    
  <!-- Per config base settings -->
  <!-- This matches up to a compiled preset in IndirectLight_ScreenSpaceGT_Config.h -->
  <Settings path="ScreenSpaceGI.Params" tags="Platform.Lockhart">
    <property id="Occlusion.Base.BilateralFilter.MinSharpness" value="2"/>
    <property id="Occlusion.Base.BilateralFilter.MaxSharpness" value="2.5"/>
  </Settings>

  <Settings path="ScreenSpaceGI.Params" tags="Config.Scarlett60Hz">
    <property id="Occlusion.Base.LineDoubled" value="true" />
  </Settings>
  
  <!-- Setup correct UseDayNightScale -->
  <Settings path="ScreenSpaceGI.Params" tags="Scenario.Race AND -Config.SSGIQuality.Ultra AND -Config.Anaconda30Hz">
    <property id="Occlusion.UseDayNightScale" value="true"/>
  </Settings>
  
  <!-- Diffuse method choice -->
  <Settings path="ScreenSpaceGI.Params" tags="Thumbnail OR Config.SSGIQuality.Off">
    <property id="Occlusion.Base.Active" value="false" />
  </Settings>
  <!-- console settings -->
  <Settings path="ScreenSpaceGI.Params" tags="Config.Scarlett30Hz OR Config.Anaconda60Hz">
    <property id="Occlusion.Base.Active" value="true" />
    <property id="Occlusion.Base.LookupMethod" value="PointDepthAware_BruteForce"/>
    <property id="Occlusion.DepthCorrectionToleranceMin" value="0.01"/>
    <property id="Occlusion.DepthCorrectionToleranceMax" value="0.1"/>
    <property id="Occlusion.NormalCorrectionTolerance" value="0.707"/>
  </Settings>
    
  <!-- general PC settings for all configs -->
  <Settings path="ScreenSpaceGI.Params" tags="Config.SSGIQuality.Medium OR Config.SSGIQuality.High OR Config.SSGIQuality.Ultra OR Config.RTGIQuality.Low OR Config.RTGIQuality.Medium OR Config.RTGIQuality.High">
    <property id="Occlusion.Base.Active" value="true" />
    <property id="Occlusion.Base.LookupMethod" value="PointDepthAware_BruteForce"/>
    <property id="Occlusion.DepthCorrectionToleranceMin" value="0.01"/>
    <property id="Occlusion.DepthCorrectionToleranceMax" value="0.1"/>
    <property id="Occlusion.NormalCorrectionTolerance" value="0.707"/>
  </Settings>
  <!-- pc medium setting -->
  <Settings path="ScreenSpaceGI.Params" tags="Config.SSGIQuality.Medium">
    <property id="Occlusion.Base.ResolutionScale" value="Half" />
    <property id="Bounce.Base.ResolutionScale" value="Half"/>
    <property id="Bounce.Base.Active" value="false" />
  </Settings>
  <!-- pc high setting -->
  <Settings path="ScreenSpaceGI.Params" tags="Config.SSGIQuality.High OR Config.RTGIQuality.Low OR Config.RTGIQuality.Medium OR Config.RTGIQuality.High">
    <!-- half res occlusion at 4k, full res if lower -->
    <!-- in practice this will mean full res for most configs as 4K accounts for < 5% of users -->
    <property id="Occlusion.Base.ResolutionScale" value="Half" tags="Render.Resolution.AtLeast4K" />
    <property id="Occlusion.Base.ResolutionScale" value="Full" tags="-Render.Resolution.AtLeast4K" />
    <property id="Bounce.Base.ResolutionScale" value="Half" />
    <property id="Bounce.Base.Active" value="false" />
  </Settings>
  <!-- pc ultra setting -->
  <Settings path="ScreenSpaceGI.Params" tags="Config.SSGIQuality.Ultra">
    <!-- same res dependent setting as high -->
    <property id="Occlusion.Base.ResolutionScale" value="Half" tags="Render.Resolution.AtLeast4K" />
    <property id="Occlusion.Base.ResolutionScale" value="Full" tags="-Render.Resolution.AtLeast4K" />
    <!-- don't think we need screen space bounce light to ever be full resolution, its too subtle -->
    <property id="Bounce.Base.ResolutionScale" value="Half"/>
    <property id="Bounce.Base.Active" value="true" />
  </Settings>

  <!-- Render Mode Settings -->
  
  <Settings path="ScreenSpaceGI.Params" tags="Largeshot.ActiveAccumulating">
    <property id="Occlusion.Base.Temporal.MinIntensity" value="0.0"/>
    <property id="Occlusion.Base.Temporal.MaxIntensity" value="0.0"/>
  </Settings>

